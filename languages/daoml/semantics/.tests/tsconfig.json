{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": [
            "ES2022"
        ],
        "outDir": "./lib",
        "rootDir": "..",
        "strict": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "./**/*.ts",
        "../helper/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "lib"
    ]
}
