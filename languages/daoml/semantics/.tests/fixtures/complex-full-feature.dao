			<associated_to _id="dao_complex_edge_assoc_11">dao_complex_perm_strat2</associated_to>
		</Committee>
		<Committee committee_ID="dao_complex_comm_optimistic" committee_description="Emergency Committee" decision_making_method="optimistic_governance" aggregation_level="0" federation_level="0" x="500" y="750" width="112" height="49">
			<is_controlled_by _id="dao_complex_edge_ctrl_07">dao_complex_comm_dispute</is_controlled_by>
		</Committee>
	</DAO>
	<DAO DAO_ID="dao_complex_dao_beta" DAO_name="Beta Sub-DAO" mission_statement="Secondary DAO demonstrating multi-DAO diagrams" hierarchical_inheritance="false" x="10" y="950" width="600" height="500">
