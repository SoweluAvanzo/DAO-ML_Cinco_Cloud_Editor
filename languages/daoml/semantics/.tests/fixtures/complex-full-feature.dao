<DAO-ML_diagram name="Complex Full Feature DAO Model" uniqueID="dao_complex_root_001" xsi:noNamespaceSchemaLocation="XSD_DAO_ML.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" x="0" y="0" width="0" height="0">
	<DAO DAO_ID="dao_complex_dao_alpha" DAO_name="Alpha DAO" mission_statement="Full-featured DAO exercising every MGL construct" hierarchical_inheritance="true" x="10" y="10" width="1200" height="900">
		<GovernanceArea gov_area_ID="dao_complex_gov_onchain" gov_area_description="Treasury Management" implementation="on-chain" x="20" y="50" width="250" height="200" />
		<GovernanceArea gov_area_ID="dao_complex_gov_hybrid" gov_area_description="Content Moderation" implementation="hybrid" x="300" y="50" width="250" height="200" />
		<GovernanceArea gov_area_ID="dao_complex_gov_offchain" gov_area_description="Dispute Resolution" implementation="off-chain" x="580" y="50" width="250" height="200" />
		<Permission permission_ID="dao_complex_perm_op1" allowed_action="Transfer Funds" permission_type="operational" ref_gov_area="dao_complex_gov_onchain" x="20" y="40" width="91" height="49" />
		<Permission permission_ID="dao_complex_perm_op2" allowed_action="Approve Expenses" permission_type="operational" ref_gov_area="dao_complex_gov_onchain" x="20" y="100" width="91" height="49" />
		<Permission permission_ID="dao_complex_perm_str1" allowed_action="Modify Governance Rules" permission_type="structural" ref_gov_area="dao_complex_gov_hybrid" x="20" y="40" width="91" height="49" />
		<Permission permission_ID="dao_complex_perm_str2" allowed_action="Create Sub-DAOs" permission_type="structural" ref_gov_area="dao_complex_gov_hybrid" x="20" y="100" width="91" height="49" />
		<Permission permission_ID="dao_complex_perm_strat1" allowed_action="Set Mission Statement" permission_type="strategic" ref_gov_area="dao_complex_gov_offchain" x="20" y="40" width="91" height="49" />
		<Permission permission_ID="dao_complex_perm_strat2" allowed_action="Dissolution Vote" permission_type="strategic" ref_gov_area="dao_complex_gov_offchain" x="20" y="100" width="91" height="49" />
		<Role role_ID="dao_complex_role_founder" role_name="Founder" n_agent_min="1" n_agent_max="3" agent_type="human" aggregation_level="2" federation_level="1" x="100" y="400" width="50" height="80">
			<associated_to _id="dao_complex_edge_assoc_01">dao_complex_perm_op1</associated_to>
			<associated_to _id="dao_complex_edge_assoc_02">dao_complex_perm_strat1</associated_to>
			<federates_into _id="dao_complex_edge_fed_01">dao_complex_comm_board</federates_into>
			<aggregates _id="dao_complex_edge_agg_r01">dao_complex_role_member</aggregates>
			<is_controlled_by _id="dao_complex_edge_ctrl_01">dao_complex_comm_board</is_controlled_by>
		</Role>
		<Role role_ID="dao_complex_role_member" role_name="Community Member" n_agent_min="0" n_agent_max="1000" agent_type="human" aggregation_level="0" federation_level="0" x="300" y="400" width="50" height="80">
			<associated_to _id="dao_complex_edge_assoc_03">dao_complex_perm_op2</associated_to>
			<federates_into _id="dao_complex_edge_fed_02">dao_complex_comm_board</federates_into>
			<is_controlled_by _id="dao_complex_edge_ctrl_02">dao_complex_comm_board</is_controlled_by>
		</Role>
		<Role role_ID="dao_complex_role_ai_curator" role_name="AI Content Curator" n_agent_min="0" n_agent_max="10" aggregation_level="0" federation_level="0" x="500" y="400" width="50" height="80">
			<associated_to _id="dao_complex_edge_assoc_04">dao_complex_perm_str1</associated_to>
			<is_controlled_by _id="dao_complex_edge_ctrl_03">dao_complex_comm_moderation</is_controlled_by>
		</Role>
		<Role role_ID="dao_complex_role_ai_auditor" role_name="AI Auditor" n_agent_min="0" n_agent_max="5" aggregation_level="1" federation_level="0" x="700" y="400" width="50" height="80">
			<associated_to _id="dao_complex_edge_assoc_05">dao_complex_perm_strat2</associated_to>
			<aggregates _id="dao_complex_edge_agg_r02">dao_complex_role_ai_curator</aggregates>
			<is_controlled_by _id="dao_complex_edge_ctrl_04">dao_complex_comm_dispute</is_controlled_by>
		</Role>
		<Role role_ID="dao_complex_role_delegate" role_name="Delegate" n_agent_min="5" n_agent_max="50" agent_type="human" aggregation_level="0" federation_level="2" x="900" y="400" width="50" height="80">
			<federates_into _id="dao_complex_edge_fed_03">dao_complex_comm_dispute</federates_into>
