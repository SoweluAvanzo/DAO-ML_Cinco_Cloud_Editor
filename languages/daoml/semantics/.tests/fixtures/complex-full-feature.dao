			<is_controlled_by _id="dao_complex_edge_ctrl_05">dao_complex_comm_board</is_controlled_by>
		</Role>
		<Committee committee_ID="dao_complex_comm_board" committee_description="Executive Board" decision_making_method="simple_majority" aggregation_level="0" federation_level="0" voting_condition="quorum >= 51%" proposalCondition="any member" x="200" y="600" width="112" height="49">
			<associated_to _id="dao_complex_edge_assoc_07">dao_complex_perm_op1</associated_to>
			<associated_to _id="dao_complex_edge_assoc_08">dao_complex_perm_str1</associated_to>
			<aggregates _id="dao_complex_edge_agg_c01">dao_complex_comm_moderation</aggregates>
		</Committee>
		<Committee committee_ID="dao_complex_comm_moderation" committee_description="Content Moderation Panel" decision_making_method="lazy_consensus" aggregation_level="1" federation_level="0" x="500" y="600" width="112" height="49">
			<associated_to _id="dao_complex_edge_assoc_09">dao_complex_perm_str1</associated_to>
			<is_controlled_by _id="dao_complex_edge_ctrl_06">dao_complex_comm_board</is_controlled_by>
		</Committee>
		<Committee committee_ID="dao_complex_comm_dispute" committee_description="Dispute Resolution Council" decision_making_method="quadratic_voting" aggregation_level="0" federation_level="1" voting_condition="token weighted" proposalCondition="stake >= 100" x="800" y="600" width="112" height="49">
			<associated_to _id="dao_complex_edge_assoc_10">dao_complex_perm_strat1</associated_to>
		</Committee>
